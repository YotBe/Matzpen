# Matzpen environment variables.
# Copy to .env.local for local dev. On Vercel, set these under
# Project → Settings → Environment Variables and REDEPLOY (NEXT_PUBLIC_*
# values are baked into the client bundle at build time).
# Full setup order: docs/production-runbook.md.

# ── Supabase (required — app hard-blocks without these) ─────────────────────
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Google Gemini (required for /assistant chat + medical-doc extraction) ───
# Server-only. Create at https://aistudio.google.com/apikey.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# ── Upstash Redis (recommended in production — persistent rate limiting) ────
# Without these the rate limiter falls back to per-instance memory.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Web push (required for war-room SOS notifications) ──────────────────────
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:ops@yourdomain.org

# ── Analytics + error tracking (optional; silently disabled when unset) ─────
NEXT_PUBLIC_POSTHOG_KEY=phc_your-key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/0
# Only needed for sourcemap upload at build time:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── App identity ─────────────────────────────────────────────────────────────
# Public origin of the deployment; used for canonical/OG metadata.
NEXT_PUBLIC_APP_URL=https://your-domain.example
# Shown in the footer, privacy, and terms pages as the operator contact.
NEXT_PUBLIC_CONTACT_EMAIL=ops@yourdomain.org

# ── Preview/demo mode (leave unset in production) ────────────────────────────
# When 'true' an unconfigured build shows fake demo data instead of blocking.
# NEXT_PUBLIC_ENABLE_PREVIEW_MODE=true
